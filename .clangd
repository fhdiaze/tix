InlayHints:
  BlockEnd: false
  Designators: true
  Enabled: true
  ParameterNames: false
  DeducedTypes: true
  DefaultArguments: false
  TypeNameLimit: 24

CompileFlags:
  Add:
    - -DDEBUG
    # build.bat gets these from vcvarsall.bat, which clangd does not run
    - -isystemC:/Program Files (x86)/Microsoft Visual Studio/18/BuildTools/VC/Tools/MSVC/14.50.35717/include
    - -isystemC:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/ucrt
    - -isystemC:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/um
    - -isystemC:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/shared

Diagnostics:
  UnusedIncludes: Strict

Documentation:
  CommentFormat: Doxygen

---
# Flags for .h files
If:
  PathMatch: .*\.h

CompileFlags:
  Add: [-xc-header]

---
# Flags for .c files
If:
  PathMatch: .*\.c

CompileFlags:
  Add: [-xc]

